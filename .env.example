# ==============================================================
# ENVIRONMENT VARIABLES (OPSIONAL)
# ==============================================================
# Anda dapat menyalin file ini menjadi `.env` jika ingin mengatur
# nomor WhatsApp atau email langsung lewat environment variable.
# Jika tidak diisi, website otomatis menggunakan data dari:
# `src/data/portfolioData.js`
# ==============================================================

# Nomor WhatsApp (gunakan kode negara 62 tanpa tanda +)
VITE_WHATSAPP_PHONE=6281234567890

# Alamat Email Utama
VITE_CONTACT_EMAIL=carson.roderick@example.com

# URL Profil GitHub
VITE_GITHUB_URL=https://github.com/carson1385
